# Postgres. `npm run db:up` starts a local database on port 54329.
DATABASE_URL="postgresql://titlecheck:titlecheck@127.0.0.1:54329/titlecheck?schema=public"
DIRECT_URL="postgresql://titlecheck:titlecheck@127.0.0.1:54329/titlecheck?schema=public"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Development only. Ignored when NODE_ENV is production.
DEV_OTP_CODE="123456"

# local | supabase
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="titlecheck-private"

# 32-byte key, base64. Used for NIN/BVN ciphertext.
DATA_ENCRYPTION_KEY=""

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

RESEND_API_KEY=""
EMAIL_FROM="TitleCheck <noreply@titlecheck.ng>"

TERMII_API_KEY=""
TERMII_SENDER_ID="TitleCheck"

KYC_PROVIDER="mock"
POLICY_VERSION="2026-10-14"
